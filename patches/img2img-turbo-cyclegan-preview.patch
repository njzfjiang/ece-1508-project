 from my_utils.dino_struct import DinoStructureLoss


+def save_a2b_preview(
+    input_path,
+    output_dir,
+    step,
+    transform,
+    vae_enc,
+    unet,
+    vae_dec,
+    scheduler,
+    text_embedding,
+    device,
+    weight_dtype,
+):
+    """Generate a comparable held-out A-to-B image without updating weights."""
+    preview_dir = os.path.join(output_dir, "previews")
+    os.makedirs(preview_dir, exist_ok=True)
+    input_image = transform(Image.open(input_path).convert("RGB"))
+    input_image.save(os.path.join(preview_dir, "input_A.png"))
+    image_tensor = transforms.ToTensor()(input_image)
+    image_tensor = transforms.Normalize([0.5], [0.5])(image_tensor).unsqueeze(0)
+    image_tensor = image_tensor.to(device=device, dtype=weight_dtype)
+    timesteps = torch.tensor(
+        [scheduler.config.num_train_timesteps - 1],
+        device=device,
+    ).long()
+
+    modules = (vae_enc, unet, vae_dec)
+    training_modes = [module.training for module in modules]
+    for module in modules:
+        module.eval()
+    with torch.no_grad():
+        generated = CycleGAN_Turbo.forward_with_networks(
+            image_tensor,
+            "a2b",
+            vae_enc,
+            unet,
+            vae_dec,
+            scheduler,
+            timesteps,
+            text_embedding[0:1].to(dtype=weight_dtype),
+        )
+    preview = transforms.ToPILImage()(
+        generated[0].float().cpu() * 0.5 + 0.5
+    )
+    preview.save(
+        os.path.join(preview_dir, f"a2b_step_{step:08d}.png")
+    )
+    for module, was_training in zip(modules, training_modes):
+        module.train(was_training)
+
+
