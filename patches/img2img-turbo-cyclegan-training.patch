+def atomic_torch_save(value, path):
+    """Avoid leaving a seemingly valid checkpoint after an interrupted write."""
+    temporary_path = f"{path}.tmp"
+    torch.save(value, temporary_path)
+    os.replace(temporary_path, path)
+
+
+def build_model_checkpoint(
+    eval_unet, eval_vae_enc, eval_vae_dec, args,
+    l_modules_unet_encoder, l_modules_unet_decoder, l_modules_unet_others,
+    vae_lora_target_modules,
+):
+    sd = {
+        "l_target_modules_encoder": l_modules_unet_encoder,
+        "l_target_modules_decoder": l_modules_unet_decoder,
+        "l_modules_others": l_modules_unet_others,
+        "rank_unet": args.lora_rank_unet,
+        "sd_encoder": get_peft_model_state_dict(eval_unet, adapter_name="default_encoder"),
+        "sd_decoder": get_peft_model_state_dict(eval_unet, adapter_name="default_decoder"),
+        "sd_other": get_peft_model_state_dict(eval_unet, adapter_name="default_others"),
+        "rank_vae": args.lora_rank_vae,
+        "vae_lora_target_modules": vae_lora_target_modules,
+        "sd_vae_enc": eval_vae_enc.state_dict(),
+        "sd_vae_dec": eval_vae_dec.state_dict(),
+    }
+    # conv_in is explicitly optimized in addition to its LoRA adapter.
+    base_conv_in = getattr(eval_unet.conv_in, "base_layer", eval_unet.conv_in)
+    sd["sd_unet_conv_in"] = base_conv_in.state_dict()
+    return sd
+
+
+def load_model_checkpoint(sd, unet, vae_enc, vae_dec, args):
+    if sd["rank_unet"] != args.lora_rank_unet or sd["rank_vae"] != args.lora_rank_vae:
+        raise ValueError(
+            "Resume checkpoint LoRA ranks do not match this run: "
+            f"checkpoint=({sd['rank_unet']}, {sd['rank_vae']}), "
+            f"requested=({args.lora_rank_unet}, {args.lora_rank_vae})"
+        )
+    adapter_states = (
+        ("default_encoder", sd["sd_encoder"]),
+        ("default_decoder", sd["sd_decoder"]),
+        ("default_others", sd["sd_other"]),
+    )
+    for adapter_name, adapter_state in adapter_states:
+        for name, parameter in unet.named_parameters():
+            state_name = name.replace(f".{adapter_name}.weight", ".weight")
+            if "lora" in name and adapter_name in name:
+                parameter.data.copy_(adapter_state[state_name])
+    if "sd_unet_conv_in" in sd:
+        base_conv_in = getattr(unet.conv_in, "base_layer", unet.conv_in)
+        base_conv_in.load_state_dict(sd["sd_unet_conv_in"])
+    vae_enc.load_state_dict(sd["sd_vae_enc"])
+    vae_dec.load_state_dict(sd["sd_vae_dec"])
+
+
+def trainable_parameter_state(module):
+    return {
+        name: parameter.detach().cpu()
+        for name, parameter in module.named_parameters()
+        if parameter.requires_grad
+    }
+
+
+def load_trainable_parameter_state(module, state, label):
+    parameters = dict(module.named_parameters())
+    missing = sorted(set(state) - set(parameters))
+    if missing:
+        raise ValueError(f"Unknown parameters in {label} resume state: {missing[:5]}")
+    for name, value in state.items():
+        parameters[name].data.copy_(value)
+
+
+def checkpoint_paths(output_dir, step):
+    checkpoint_dir = os.path.join(output_dir, "checkpoints")
+    return (
+        os.path.join(checkpoint_dir, f"model_{step}.pkl"),
+        os.path.join(checkpoint_dir, f"training_state_{step}.pt"),
+    )
+
+
+def resolve_resume_paths(path):
+    path = os.path.abspath(path)
+    filename = os.path.basename(path)
+    if filename.startswith("model_") and filename.endswith(".pkl"):
+        step_text = filename[len("model_"):-len(".pkl")]
+        model_path = path
+        state_path = os.path.join(os.path.dirname(path), f"training_state_{step_text}.pt")
+    elif filename.startswith("training_state_") and filename.endswith(".pt"):
+        step_text = filename[len("training_state_"):-len(".pt")]
+        state_path = path
+        model_path = os.path.join(os.path.dirname(path), f"model_{step_text}.pkl")
+    else:
+        raise ValueError(
+            "--resume_from_checkpoint must name model_<step>.pkl or "
+            "training_state_<step>.pt"
+        )
+    if not step_text.isdigit():
+        raise ValueError(f"Could not read a step number from resume checkpoint: {path}")
+    for required_path in (model_path, state_path):
+        if not os.path.isfile(required_path):
+            raise FileNotFoundError(f"Required resume file not found: {required_path}")
+    return model_path, state_path, int(step_text)
+
+
+def rng_state_dict():
+    return {
+        "python": random.getstate(),
+        "numpy": np.random.get_state(),
+        "torch": torch.get_rng_state(),
+        "cuda": torch.cuda.get_rng_state_all(),
+    }
+
+
+def restore_rng_state(state):
+    random.setstate(state["python"])
+    np.random.set_state(state["numpy"])
+    torch.set_rng_state(state["torch"])
+    torch.cuda.set_rng_state_all(state["cuda"])
+
+
+def prepare_loss_csv(path, resume_step):
+    if resume_step and os.path.isfile(path):
+        with open(path, newline="", encoding="utf-8") as handle:
+            rows = list(csv.DictReader(handle))
+        rows = [row for row in rows if int(row["step"]) <= resume_step]
+        temporary_path = f"{path}.tmp"
+        with open(temporary_path, "w", newline="", encoding="utf-8") as handle:
+            writer = csv.DictWriter(handle, fieldnames=LOSS_FIELDS)
+            writer.writeheader()
+            writer.writerows(rows)
+        os.replace(temporary_path, path)
+    exists = os.path.isfile(path) and os.path.getsize(path) > 0
+    handle = open(path, "a", newline="", encoding="utf-8")
+    writer = csv.DictWriter(handle, fieldnames=LOSS_FIELDS)
+    if not exists:
+        writer.writeheader()
+        handle.flush()
+    return handle, writer
+
